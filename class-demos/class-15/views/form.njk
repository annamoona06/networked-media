{# form: sends data via a POST request to the server #}
{# to send data to server, we need attributes in the form #}
{# attributes: method, action #}
{# method: what type of http request are we making? for forms, always be POST#}
{# action: the route that will handle the data on the server #}
{# for every <form></form> html with a method & action, we need an app.post in the server.js#}
{% include "partial-nav.njk" %}

<form method="POST" action="/send-message">
    {# inputs are the data to be sent #}
    {# in order to process the data, we need to include the name attribute 
    which will name the property in the request.body #}
    {# there are a lot of different input types you can accept#}
    <input type="text" placeholder="what is your name" name="user">
    <input type="text" placeholder="write a message" name="message">
    <input type="submit" value="send-message">
</form>
